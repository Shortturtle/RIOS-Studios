  dialogue:
  - speakerName: Gwen (You)
    speakerSprite: {fileID: 736716699, guid: b8f420521dfb8654facb0ce5996feb91, type: 3}
    text: Then...why do you look so gloomy?
  - speakerName: Ivor
    speakerSprite: {fileID: 453159133, guid: ebd9bc96c7121144a93a8020234058ab, type: 3}
    text: Hm. My name is Ivor. And see...
  - speakerName: Ivor
    speakerSprite: {fileID: 453159133, guid: ebd9bc96c7121144a93a8020234058ab, type: 3}
    text: I'm quite parched...
  - speakerName: Ivor
    speakerSprite: {fileID: 453159133, guid: ebd9bc96c7121144a93a8020234058ab, type: 3}
    text: I'm quite parched...
  responses:
  - responseText: Sure!
    dialogueObject: {fileID: 11400000, guid: e461295009ae9ad41bc27597247647b8, type: 2}
  - responseText: Do I have to...?
