  m_Script: {fileID: 11500000, guid: 8e11ba7534ba6c14fa8773a9171a3791, type: 3}
  m_Name: Wait! I didn't mean that!
  m_EditorClassIdentifier: 
  dialogue:
  - speakerName: Gwen (You)
    speakerSprite: {fileID: 736716699, guid: b8f420521dfb8654facb0ce5996feb91, type: 3}
    text: 'Wait! I didn''t mean it like that! '
  - speakerName: Gwen (You)
    speakerSprite: {fileID: 736716699, guid: b8f420521dfb8654facb0ce5996feb91, type: 3}
    text: I'm sorry, my name is Gwen.
  - speakerName: Gwen (You)
    speakerSprite: {fileID: 736716699, guid: b8f420521dfb8654facb0ce5996feb91, type: 3}
    text: Uhm... Is there anything I could do to apologise?
  - speakerName: Ivor
    speakerSprite: {fileID: 453159133, guid: ebd9bc96c7121144a93a8020234058ab, type: 3}
    text: Hm. My name is Ivor. And perhaps you there is something.
  responses:
  - responseText: I'll do anything!
    dialogueObject: {fileID: 11400000, guid: 9804e501a76dbeb4d9ebe9a74251e45d, type: 2}
