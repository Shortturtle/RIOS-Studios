  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8e11ba7534ba6c14fa8773a9171a3791, type: 3}
  m_Name: Then...Why...
  m_EditorClassIdentifier: 
  dialogue:
  - speakerName: Gwen (You)
    speakerSprite: {fileID: -140982710, guid: c4d0f2301853d884eae9ba96908dfe07, type: 3}
    text: Then...why do you look so gloomy?
  - speakerName: Ivor
    speakerSprite: {fileID: -210047980, guid: f34673eeb5057a34fa75868b6a66ca26, type: 3}
    text: Hm. My name is Ivor. And perhaps you could help me.
  - speakerName: Ivor
    speakerSprite: {fileID: -210047980, guid: f34673eeb5057a34fa75868b6a66ca26, type: 3}
    text: There are a few animated veggies outside the city walls. <color=yellow>Help
      me kill 5 mushrooms.</color>
  responses:
  - responseText: Sure!
    dialogueObject: {fileID: 11400000, guid: e461295009ae9ad41bc27597247647b8, type: 2}
  - responseText: Do I have to...?
    dialogueObject: {fileID: 11400000, guid: 6672074529f0cbc45a258c940af46bd3, type: 2}
