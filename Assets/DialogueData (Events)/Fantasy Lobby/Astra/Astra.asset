  m_Script: {fileID: 11500000, guid: 8e11ba7534ba6c14fa8773a9171a3791, type: 3}
  m_Name: Astra
  m_EditorClassIdentifier: 
  dialogue:
  - speakerName: ???
    speakerSprite: {fileID: -65985448, guid: 89d22a4777a16d449af8c84617230ae6, type: 3}
    text: Don't tell me you're going out there alone.
  - speakerName: Astra
    speakerSprite: {fileID: 2114149146, guid: 13448a08ff92ae145b264dcb18177b00, type: 3}
    text: My name's Astra. I was just on my way out too to collect ingredients. Why
      don't we go together?
  - speakerName: Astra
    speakerSprite: {fileID: 2114149146, guid: 13448a08ff92ae145b264dcb18177b00, type: 3}
    text: It's safer that way.
  responses:
  - responseText: Sure!
    dialogueObject: {fileID: 11400000, guid: ca2227381b376f34684b79e159bd7ae2, type: 2}
  - responseText: Actaully...
    dialogueObject: {fileID: 11400000, guid: ad99c59868226eb4287d5290d2ff6bbd, type: 2}
