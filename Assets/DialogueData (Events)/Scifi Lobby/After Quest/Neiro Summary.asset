  dialogue:
  - speakerName: Neiro
    speakerSprite: {fileID: 1911912498, guid: 99a4f2e427b911549bb4ee79a17b3534, type: 3}
    text: Oh, hey! Back again?
  - speakerName: Neiro
    speakerSprite: {fileID: 1911912498, guid: 99a4f2e427b911549bb4ee79a17b3534, type: 3}
    text: Actually, I found this extra ticket in my purse.
  - speakerName: Neiro
    speakerSprite: {fileID: 1911912498, guid: 99a4f2e427b911549bb4ee79a17b3534, type: 3}
    text: Wanna come to the concert with me?
  responses:
  - responseText: A break could be nice...
