  m_Script: {fileID: 11500000, guid: 8e11ba7534ba6c14fa8773a9171a3791, type: 3}
  m_Name: Here you go
  m_EditorClassIdentifier: 
  dialogue:
  - speakerName: Gwen (You)
    speakerSprite: {fileID: 736716699, guid: b8f420521dfb8654facb0ce5996feb91, type: 3}
    text: Yep! Here you go.
  - speakerName: Neiro
    speakerSprite: {fileID: 1911912498, guid: 99a4f2e427b911549bb4ee79a17b3534, type: 3}
    text: Wow, none of my things are damaged or missing. You're a really good mover!
  - speakerName: Neiro
    speakerSprite: {fileID: 1911912498, guid: 99a4f2e427b911549bb4ee79a17b3534, type: 3}
    text: You're pretty cool, Gwen.
  - speakerName: Neiro
    speakerSprite: {fileID: 1911912498, guid: 99a4f2e427b911549bb4ee79a17b3534, type: 3}
    text: If you ever find yourself in need of business or help, call on me, yeah?
  - speakerName: Neiro
    speakerSprite: {fileID: 1911912498, guid: 99a4f2e427b911549bb4ee79a17b3534, type: 3}
    text: Now what to do with these tickets...
  responses: []
