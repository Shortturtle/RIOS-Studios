  dialogue:
  - speakerName: Gwen (You)
    speakerSprite: {fileID: 736716699, guid: b8f420521dfb8654facb0ce5996feb91, type: 3}
    text: <i>sigh...</i>
  - speakerName: ???
    speakerSprite: {fileID: 1911912498, guid: 99a4f2e427b911549bb4ee79a17b3534, type: 3}
    text: 'Well, I don''t think I can help you find your friend, but what about this:'
  - speakerName: ???
    speakerSprite: {fileID: 1911912498, guid: 99a4f2e427b911549bb4ee79a17b3534, type: 3}
    text: If you help me <color=yellow>bring the rest of my boxes down from the roof</color>,
      then I'll come and help you fight whatever locals!
  - speakerName: Neiro
    speakerSprite: {fileID: 1911912498, guid: 99a4f2e427b911549bb4ee79a17b3534, type: 3}
    text: I'm Neiro, by the way.
  responses:
  - responseText: Extra help is always nice.
    dialogueObject: {fileID: 11400000, guid: 0b6eb9320fa29eb49aa42cdd86a4aba6, type: 2}
