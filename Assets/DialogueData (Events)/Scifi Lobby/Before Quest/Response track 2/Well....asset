--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8e11ba7534ba6c14fa8773a9171a3791, type: 3}
  m_Name: Well...
  m_EditorClassIdentifier: 
  dialogue:
  - speakerName: Gwen (You)
    speakerSprite: {fileID: 736716699, guid: b8f420521dfb8654facb0ce5996feb91, type: 3}
    text: 'Actually, my name is Gwen, and I''m searching for my friend, Claire. '
  - speakerName: Gwen (You)
    speakerSprite: {fileID: 736716699, guid: b8f420521dfb8654facb0ce5996feb91, type: 3}
    text: She's got long, silky silver hair and is dressed in purple, kinda like
      me.
  - speakerName: Gwen (You)
    speakerSprite: {fileID: 736716699, guid: b8f420521dfb8654facb0ce5996feb91, type: 3}
    text: I've been breaking rifts in the dimensional fabric to travel. And the locals-
      well, not all of them have been very nice.
  - speakerName: Gwen (You)
    speakerSprite: {fileID: 736716699, guid: b8f420521dfb8654facb0ce5996feb91, type: 3}
    text: I don't suppose you've seen her, have you?
  - speakerName: ???
    speakerSprite: {fileID: 1911912498, guid: 99a4f2e427b911549bb4ee79a17b3534, type: 3}
    text: Oh...
  - speakerName: ???
    speakerSprite: {fileID: 1911912498, guid: 99a4f2e427b911549bb4ee79a17b3534, type: 3}
    text: I'm sorry to hear that, but no. I've just recently moved here.
  responses:
  - responseText: <i>sigh...</i>
    dialogueObject: {fileID: 11400000, guid: 15b24674cc728364e88916a83e4e12ac, type: 2}
