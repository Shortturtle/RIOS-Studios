  m_Script: {fileID: 11500000, guid: 8e11ba7534ba6c14fa8773a9171a3791, type: 3}
  m_Name: Well...
  m_EditorClassIdentifier: 
  dialogue:
  - speakerName: Gwen (You)
    speakerSprite: {fileID: 0}
    text: Actually, my name is Gwen and I'm searching for my friend, Claire. She's
      got long, silky silver hair and dressed in purple, kinda like me.
  - speakerName: Gwen (You)
    speakerSprite: {fileID: 0}
    text: I've been breaking rifts in the dimensional fabic to travel. And the locals-
      well, not all of them have been very nice.
  - speakerName: Gwen (You)
    speakerSprite: {fileID: 0}
    text: I don't supposed you've seen her, have you?
  - speakerName: ???
    speakerSprite: {fileID: 0}
    text: Oh...
  - speakerName: ???
    speakerSprite: {fileID: 0}
    text: I'm sorry to hear that, but no. I've just recently moved here.
  responses:
  - responseText: <i>sigh...</i>
    dialogueObject: {fileID: 11400000, guid: 15b24674cc728364e88916a83e4e12ac, type: 2}
