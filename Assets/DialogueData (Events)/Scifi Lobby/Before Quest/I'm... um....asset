  m_Script: {fileID: 11500000, guid: 8e11ba7534ba6c14fa8773a9171a3791, type: 3}
  m_Name: I'm... um...
  m_EditorClassIdentifier: 
  dialogue:
  - speakerName: Gwen (You)
    speakerSprite: {fileID: 736716699, guid: b8f420521dfb8654facb0ce5996feb91, type: 3}
    text: I'm... um...
  - speakerName: Gwen (You)
    speakerSprite: {fileID: 736716699, guid: b8f420521dfb8654facb0ce5996feb91, type: 3}
    text: I'm... your new mover, Gwen!
  - speakerName: Gwen (You)
    speakerSprite: {fileID: 736716699, guid: b8f420521dfb8654facb0ce5996feb91, type: 3}
    text: Yes, that's right. I'm here to move your stuff, miss...
  - speakerName: Neiro
    speakerSprite: {fileID: 1911912498, guid: 99a4f2e427b911549bb4ee79a17b3534, type: 3}
    text: Huh. I didn't know I hired a mover. Anyway, I'm Neiro.
  - speakerName: Neiro
    speakerSprite: {fileID: 1911912498, guid: 99a4f2e427b911549bb4ee79a17b3534, type: 3}
    text: And in that case, there's still <color=yellow>some boxes on the roof. Bring
      them to me.</color> Please and thanks!
  responses: []
