  dialogue:
  - speakerName: Gwen (You)
    speakerSprite: {fileID: 736716699, guid: b8f420521dfb8654facb0ce5996feb91, type: 3}
    text: Argg! She isn't here either!
  - speakerName: Pierrot
    speakerSprite: {fileID: -403000518, guid: b85821c9d4c19c54da77223d8939e3e6, type: 3}
    text: Cheer up, Gwen. I'm sure your friend will turn up soon...
  responses:
  - responseText: But what if she doesn't!
