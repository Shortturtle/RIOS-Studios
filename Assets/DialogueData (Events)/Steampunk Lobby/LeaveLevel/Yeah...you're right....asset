  m_Script: {fileID: 11500000, guid: 8e11ba7534ba6c14fa8773a9171a3791, type: 3}
  m_Name: Yeah...you're right...
  m_EditorClassIdentifier: 
  dialogue:
  - speakerName: Gwen (You)
    speakerSprite: {fileID: 736716699, guid: b8f420521dfb8654facb0ce5996feb91, type: 3}
    text: Yeah... you're right...
  - speakerName: Gwen (You)
    speakerSprite: {fileID: 736716699, guid: b8f420521dfb8654facb0ce5996feb91, type: 3}
    text: It's just hard to stay positive.
  - speakerName: Odette
    speakerSprite: {fileID: -638421324, guid: c68a2572b395dfc4fad2b69f63a5c083, type: 3}
    text: Who knows? Maybe she's in the next dimension you visit.
  - speakerName: Gwen (You)
    speakerSprite: {fileID: 736716699, guid: b8f420521dfb8654facb0ce5996feb91, type: 3}
    text: You know what? You're so right! The next one for sure.
  - speakerName: Gwen (You)
    speakerSprite: {fileID: 736716699, guid: b8f420521dfb8654facb0ce5996feb91, type: 3}
    text: Wait for me, Claire. I'm coming.
  responses: []
