MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8e11ba7534ba6c14fa8773a9171a3791, type: 3}
  m_Name: Pls don't hurt me!
  m_EditorClassIdentifier: 
  dialogue:
  - speakerName: Gwen (You)
    speakerSprite: {fileID: 736716699, guid: b8f420521dfb8654facb0ce5996feb91, type: 3}
    text: Wait! I come in peace!
  - speakerName: Gwen (You)
    speakerSprite: {fileID: 736716699, guid: b8f420521dfb8654facb0ce5996feb91, type: 3}
    text: My name is Gwen and I'm travelling through dimensions to find my friend!
  - speakerName: Gwen (You)
    speakerSprite: {fileID: 736716699, guid: b8f420521dfb8654facb0ce5996feb91, type: 3}
    text: Please don't hurt me!!!
  - speakerName: ???
    speakerSprite: {fileID: -638421324, guid: c68a2572b395dfc4fad2b69f63a5c083, type: 3}
    text: ...
  - speakerName: Odette
    speakerSprite: {fileID: -638421324, guid: c68a2572b395dfc4fad2b69f63a5c083, type: 3}
    text: Well, Gwen, I am Odette. And you are currently in my house. You've just
      caught me in the middle of my work.
  responses:
  - responseText: This is your house..?
    dialogueObject: {fileID: 11400000, guid: d17990945cda0ca48b0223e0cb87e669, type: 2}
