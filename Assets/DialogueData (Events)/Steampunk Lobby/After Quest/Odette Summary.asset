  m_Script: {fileID: 11500000, guid: 8e11ba7534ba6c14fa8773a9171a3791, type: 3}
  m_Name: Odette Summary
  m_EditorClassIdentifier: 
  dialogue:
  - speakerName: Odette
    speakerSprite: {fileID: -638421324, guid: c68a2572b395dfc4fad2b69f63a5c083, type: 3}
    text: What are you still doing here, are you not on a quest to find your friend?
  - speakerName: Odette
    speakerSprite: {fileID: -638421324, guid: c68a2572b395dfc4fad2b69f63a5c083, type: 3}
    text: You can ask my daughter, Perriot, for help if you need.
  - speakerName: Odette
    speakerSprite: {fileID: -638421324, guid: c68a2572b395dfc4fad2b69f63a5c083, type: 3}
    text: She's just in the other room. Be a dear and make sure she doesn't hurt
      herself, will you?
  responses: []
