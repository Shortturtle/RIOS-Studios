  m_Script: {fileID: 11500000, guid: 8e11ba7534ba6c14fa8773a9171a3791, type: 3}
  m_Name: Mhm!
  m_EditorClassIdentifier: 
  dialogue:
  - speakerName: Gwen (You)
    speakerSprite: {fileID: 736716699, guid: b8f420521dfb8654facb0ce5996feb91, type: 3}
    text: Mhm! Fire is burning bright, and this is your whetstone, right?
  - speakerName: Odette
    speakerSprite: {fileID: -638421324, guid: c68a2572b395dfc4fad2b69f63a5c083, type: 3}
    text: Yes, I suppose you are adequate at following instructions.
  - speakerName: Odette
    speakerSprite: {fileID: -638421324, guid: c68a2572b395dfc4fad2b69f63a5c083, type: 3}
    text: Well, I wish you luck in finding your friend. Should you need it, you may
      ask for my help.
  - speakerName: Odette
    speakerSprite: {fileID: -638421324, guid: c68a2572b395dfc4fad2b69f63a5c083, type: 3}
    text: I know my way around weapons, if you couldn't tell.
  responses: []
