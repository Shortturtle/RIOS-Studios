  m_Script: {fileID: 11500000, guid: 8e11ba7534ba6c14fa8773a9171a3791, type: 3}
  m_Name: Pierrot
  m_EditorClassIdentifier: 
  dialogue:
  - speakerName: Pierrot
    speakerSprite: {fileID: -403000518, guid: b85821c9d4c19c54da77223d8939e3e6, type: 3}
    text: Hm? Are you planning to leave too?
  - speakerName: Pierrot
    speakerSprite: {fileID: -403000518, guid: b85821c9d4c19c54da77223d8939e3e6, type: 3}
    text: I'm just looking for my next diving spot.
  - speakerName: Pierrot
    speakerSprite: {fileID: -403000518, guid: b85821c9d4c19c54da77223d8939e3e6, type: 3}
    text: Mother can be...
  - speakerName: Pierrot
    speakerSprite: {fileID: -403000518, guid: b85821c9d4c19c54da77223d8939e3e6, type: 3}
    text: Anyway, would you like to come with me?
  responses:
  - responseText: Yeah I don't see why not.
    dialogueObject: {fileID: 11400000, guid: 2585501cb6ea4e044a3dd648704bda20, type: 2}
